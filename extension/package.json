{
  "name": "relo-code",
  "displayName": "Relo Code",
  "description": "Context-managed multi-agent software engineering for Visual Studio Code. Relo orchestrates; OpenCode executes.",
  "version": "0.1.0",
  "publisher": "relocode",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCustomEditor:relo.canvas"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "relo.canvas",
        "displayName": "Relo Canvas",
        "selector": [
          {
            "filenamePattern": "*.relo-canvas"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "relo",
          "title": "Relo Code",
          "icon": "media/relo.svg"
        }
      ]
    },
    "views": {
      "relo": [
        {
          "id": "relo.chat",
          "name": "Relo",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "relo.canvas.open",
        "title": "Relo: Open Canvas"
      },
      {
        "command": "relo.canvas.popout",
        "title": "Relo: Pop Out Canvas"
      },
      {
        "command": "relo.canvas.capture",
        "title": "Relo: Capture Canvas"
      },
      {
        "command": "relo.canvas.inspect",
        "title": "Relo: Inspect Canvas"
      },
      {
        "command": "relo.selectRepository",
        "title": "Relo: Select Repository"
      },
      {
        "command": "relo.open",
        "title": "Relo: Open"
      },
      {
        "command": "relo.newSession",
        "title": "Relo: New Session",
        "icon": "$(add)"
      },
      {
        "command": "relo.sessionHistory",
        "title": "Relo: Session History",
        "icon": "$(history)"
      },
      {
        "command": "relo.dashboard",
        "title": "Relo: Open Dashboard"
      },
      {
        "command": "relo.runTask",
        "title": "Relo: Run Task"
      },
      {
        "command": "relo.planTask",
        "title": "Relo: Plan Task"
      },
      {
        "command": "relo.reviewChanges",
        "title": "Relo: Review Changes"
      },
      {
        "command": "relo.openAgents",
        "title": "Relo: Open Agents"
      },
      {
        "command": "relo.openTasks",
        "title": "Relo: Open Tasks"
      },
      {
        "command": "relo.openContext",
        "title": "Relo: Open Context"
      },
      {
        "command": "relo.openChanges",
        "title": "Relo: Open Changes"
      },
      {
        "command": "relo.openVerification",
        "title": "Relo: Open Checks"
      },
      {
        "command": "relo.openLogs",
        "title": "Relo: Open Logs"
      },
      {
        "command": "relo.pause",
        "title": "Relo: Pause"
      },
      {
        "command": "relo.resume",
        "title": "Relo: Resume"
      },
      {
        "command": "relo.stopAll",
        "title": "Relo: Stop All Agents"
      },
      {
        "command": "relo.refreshPrimary",
        "title": "Relo: Refresh Primary Context"
      },
      {
        "command": "relo.selectPrimaryModel",
        "title": "Relo: Select Primary Model"
      },
      {
        "command": "relo.selectTier1Model",
        "title": "Relo: Select Tier 1 Model"
      },
      {
        "command": "relo.selectTier2Model",
        "title": "Relo: Select Tier 2 Model"
      },
      {
        "command": "relo.restartBackend",
        "title": "Relo: Restart Backend"
      },
      {
        "command": "relo.configureDifficultyRouting",
        "title": "Relo: Configure Difficulty Routing"
      },
      {
        "command": "relo.showCacheStats",
        "title": "Relo: Show Cache Stats"
      },
      {
        "command": "relo.settings",
        "title": "Relo: Settings"
      },
      {
        "command": "relo.askSelection",
        "title": "Ask Relo About Selection"
      },
      {
        "command": "relo.fixSelection",
        "title": "Fix With Relo"
      },
      {
        "command": "relo.refactorSelection",
        "title": "Refactor With Relo"
      },
      {
        "command": "relo.reviewSelection",
        "title": "Review With Relo"
      },
      {
        "command": "relo.askFile",
        "title": "Ask Relo About File"
      },
      {
        "command": "relo.reviewFile",
        "title": "Review File"
      },
      {
        "command": "relo.askFolder",
        "title": "Ask Relo About Folder"
      },
      {
        "command": "relo.agent.stop",
        "title": "Stop Agent"
      },
      {
        "command": "relo.agent.refresh",
        "title": "Refresh Context"
      },
      {
        "command": "relo.agent.inspect",
        "title": "Inspect Context"
      },
      {
        "command": "relo.agent.openWorktree",
        "title": "Open Worktree"
      },
      {
        "command": "relo.changes.accept",
        "title": "Accept Change"
      },
      {
        "command": "relo.changes.acceptWithParents",
        "title": "Relo: Accept Change with Parents"
      },
      {
        "command": "relo.changes.reject",
        "title": "Reject Change"
      },
      {
        "command": "relo.changes.rejectWithDependents",
        "title": "Relo: Reject Change and Dependents"
      },
      {
        "command": "relo.changes.rebaseWithoutParent",
        "title": "Relo: Rebase Change without Parent"
      },
      {
        "command": "relo.changes.diff",
        "title": "Open Diff"
      },
      {
        "command": "relo.changes.resolveAgent",
        "title": "Relo: Take the Agent's Version"
      },
      {
        "command": "relo.changes.resolveMine",
        "title": "Relo: Keep Mine"
      },
      {
        "command": "relo.changes.resolveHead",
        "title": "Relo: Send to Head Agent"
      },
      {
        "command": "relo.changes.acceptAll",
        "title": "Relo: Accept All Changes"
      },
      {
        "command": "relo.changes.rejectAll",
        "title": "Relo: Reject All Changes"
      },
      {
        "command": "relo.changes.undo",
        "title": "Relo: Undo Accepted Change"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "relo.newSession",
          "when": "view == relo.chat",
          "group": "navigation@1"
        },
        {
          "command": "relo.sessionHistory",
          "when": "view == relo.chat",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "relo.askSelection",
          "group": "relo@1",
          "when": "editorHasSelection"
        },
        {
          "command": "relo.fixSelection",
          "group": "relo@2",
          "when": "editorHasSelection"
        },
        {
          "command": "relo.refactorSelection",
          "group": "relo@3",
          "when": "editorHasSelection"
        },
        {
          "command": "relo.reviewSelection",
          "group": "relo@4",
          "when": "editorHasSelection"
        }
      ],
      "explorer/context": [
        {
          "command": "relo.askFile",
          "group": "relo@1",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "relo.reviewFile",
          "group": "relo@2",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "relo.askFolder",
          "group": "relo@1",
          "when": "explorerResourceIsFolder"
        }
      ],
      "commandPalette": [
        {
          "command": "relo.agent.stop",
          "when": "false"
        },
        {
          "command": "relo.agent.refresh",
          "when": "false"
        },
        {
          "command": "relo.agent.inspect",
          "when": "false"
        },
        {
          "command": "relo.agent.openWorktree",
          "when": "false"
        },
        {
          "command": "relo.changes.accept",
          "when": "false"
        },
        {
          "command": "relo.changes.acceptWithParents",
          "when": "false"
        },
        {
          "command": "relo.changes.reject",
          "when": "false"
        },
        {
          "command": "relo.changes.rejectWithDependents",
          "when": "false"
        },
        {
          "command": "relo.changes.rebaseWithoutParent",
          "when": "false"
        },
        {
          "command": "relo.changes.diff",
          "when": "false"
        },
        {
          "command": "relo.changes.undo",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "relo.open",
        "key": "ctrl+shift+.",
        "mac": "cmd+shift+."
      }
    ],
    "configuration": {
      "title": "Relo Code",
      "properties": {
        "relo.primaryModel": {
          "type": "string",
          "default": "",
          "description": "Primary orchestrator model (provider/model)."
        },
        "relo.tier1Model": {
          "type": "string",
          "default": "",
          "description": "Model for medium and hard tasks. Relo sends trivial and easy tasks and probes to Tier 2, so put your stronger worker model here and your cheapest in Tier 2."
        },
        "relo.tier2Model": {
          "type": "string",
          "default": "",
          "description": "Cheap model for trivial and easy tasks and for probes. Put your cheapest model here; a stronger model here is paid for on every small task."
        },
        "relo.routing.mode": {
          "type": "string",
          "enum": [
            "simple",
            "advanced"
          ],
          "default": "simple",
          "description": "Simple: Primary plus two worker tiers. Advanced: pick a model per task difficulty."
        },
        "relo.models.contextLimit": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Global context cap in tokens for every model (0 = no cap). A model with a smaller window uses its own maximum."
        },
        "relo.models.efforts": {
          "type": "object",
          "default": {},
          "description": "Reasoning effort per model, keyed provider/model. Missing = model default."
        },
        "relo.providers": {
          "type": "array",
          "default": [],
          "scope": "application",
          "description": "Custom OpenAI- or Anthropic-compatible providers. API keys are stored in VS Code secret storage, never here.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "baseURL"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "openai",
                  "anthropic"
                ]
              },
              "baseURL": {
                "type": "string"
              },
              "models": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "context": {
                      "type": "integer"
                    },
                    "output": {
                      "type": "integer"
                    },
                    "reasoning": {
                      "type": "boolean"
                    },
                    "efforts": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "vision": {
                      "type": "boolean",
                      "description": "Whether the model accepts images. Leave it out to use what the endpoint or OpenCode's catalog reports, or a guess from the model id. Text-only models are declared so to OpenCode and never get the relo_image tool."
                    },
                    "kind": {
                      "type": "string",
                      "enum": ["openai", "anthropic"],
                      "description": "The API this model is spoken to in at the provider's base URL, when it differs from the provider's kind. Set anthropic for Claude behind an OpenAI-compatible router such as 9router: the OpenAI format cannot carry the signature on Claude's thinking, so the thinking is dropped between tool steps and Claude re-derives it on every step."
                    }
                  }
                }
              }
            }
          }
        },
        "relo.routing.byDifficulty": {
          "type": "object",
          "default": {},
          "description": "Optional model overrides by task difficulty: trivial, easy, medium, complex, hard, expert. Without a complex entry, complex tasks use the hard model."
        },
        "relo.routing.escalate": {
          "type": "boolean",
          "default": true,
          "description": "Allow escalation to a stronger model after repeated failures."
        },
        "relo.report.maxChars": {
          "type": "number",
          "default": 1200,
          "minimum": 1,
          "description": "Maximum characters in agent report fields."
        },
        "relo.efficiency.preset": {
          "type": "string",
          "enum": [
            "off",
            "auto",
            "max"
          ],
          "default": "off"
        },
        "relo.efficiency.voice": {
          "type": "string",
          "enum": [
            "auto",
            "off",
            "lite",
            "full",
            "ultra"
          ],
          "default": "auto"
        },
        "relo.efficiency.craft": {
          "type": "string",
          "enum": [
            "auto",
            "off",
            "lite",
            "full",
            "ultra"
          ],
          "default": "auto"
        },
        "relo.efficiency.roles": {
          "type": "object",
          "default": {}
        },
        "relo.efficiency.planLean": {
          "type": "boolean",
          "default": false
        },
        "relo.maxConcurrentAgents": {
          "type": "number",
          "default": 6
        },
        "relo.maxTier1Agents": {
          "type": "number",
          "default": 3
        },
        "relo.maxTier2Agents": {
          "type": "number",
          "default": 4
        },
        "relo.maxHierarchyDepth": {
          "type": "number",
          "default": 3
        },
        "relo.maxRetries": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "maximum": 5,
          "description": "How many times a failed task may be retried (on a stronger model) before Relo stops and reports it. Every retry costs tokens."
        },
        "relo.context.compactAt": {
          "type": "number",
          "default": 0.9,
          "minimum": 0,
          "maximum": 1,
          "description": "Summarize an agent's conversation when it reaches this share of its context window (the smaller of the context limit and the model's own maximum). The work carries on from the summary. 0 turns this off."
        },
        "relo.context.maxUtilization": {
          "type": "number",
          "default": 0.85
        },
        "relo.context.autoRefresh": {
          "type": "boolean",
          "default": true
        },
        "relo.context.refreshThreshold": {
          "type": "number",
          "default": 0.8
        },
        "relo.context.keepRawHistory": {
          "type": "boolean",
          "default": true
        },
        "relo.context.projectMemory": {
          "type": "boolean",
          "default": true
        },
        "relo.context.compressionStrategy": {
          "type": "string",
          "enum": [
            "variable",
            "full_history",
            "summary",
            "aggressive_refresh",
            "role_optimized"
          ],
          "default": "variable"
        },
        "relo.repository": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Absolute repository or workspace folder path. Empty uses the first workspace folder. Changing this restarts Relo Core. Changes use this repository's checked-out branch."
        },
        "relo.changes.autoApply": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Automatically accept clean proposed changes into the selected repository as unstaged edits. Never stages, commits or pushes. Conflicted changes remain proposed for review."
        },
        "relo.changes.lazyConflicts": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Project every proposed change against the workspace after each accept or undo, so conflicts are visible without clicking Resolve conflicts. Off keeps the string-based behavior."
        },
        "relo.changes.dependentSemantics": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Refuse to accept a stacked change alone, accept it with its parents as a group, block dependents when a parent is rejected or superseded, and let auto-apply release a dependent only after its parents are accepted."
        },
        "relo.changes.ignorePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".relo/**",
            "**/obj/**",
            "**/bin/Debug/**",
            "**/bin/Release/**"
          ],
          "scope": "window",
          "description": "Workspace-relative glob patterns for build output and generated files that Relo never shows as changes or conflicts. A pattern without / matches a file name anywhere (*.log); a pattern with / is anchored at the workspace root; ** matches any number of folders. .relo/** is always ignored."
        },
        "relo.changes.unionPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "*.md",
            "*.txt"
          ],
          "scope": "window",
          "description": "Files where, when two sides both only add lines, Relo keeps both sides' lines automatically instead of reporting a conflict (ledgers, changelogs)."
        },
        "relo.changes.takeLatestPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "window",
          "description": "Files, typically rebuilt binaries such as **/Assemblies/*.dll, where the newest agent version always wins when two agents produce one."
        },
        "relo.scheduler.pathLeases": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Have tasks declare the files they will edit and keep two tasks with overlapping paths from running at once. The later task waits for the earlier to finish, then starts with the earlier task's pending patches applied to those paths and records them as dependencies. Off ignores declared paths."
        },
        "relo.workspace.mode": {
          "type": "string",
          "enum": [
            "worktree",
            "virtual",
            "auto"
          ],
          "enumDescriptions": [
            "Every agent gets its own Git worktree: a full checkout of the repository. Opt-in, and the fallback for everything below.",
            "Agents share one immutable base snapshot and each keeps its own edits as Git objects. A folder is checked out only while a tool needs real files. The default. Falls back to a worktree, with a notice, in a repository whose Git settings rewrite file content on checkout.",
            "Virtual workspaces where the repository supports them, worktrees everywhere else."
          ],
          "default": "virtual",
          "scope": "window",
          "description": "How Relo isolates each agent's edits. Applies to agents created after the change; an agent already working keeps what it has. Your own folder is never written by either mode, and neither mode stages, commits or pushes."
        },
        "relo.workspace.materialization": {
          "type": "string",
          "enum": [
            "automatic",
            "worktree"
          ],
          "default": "automatic",
          "scope": "window",
          "description": "How a folder is made for an agent in a virtual workspace when its tools need real files (build, test, shell). Both choices use a Git worktree today; automatic lets Relo pick a cheaper method when one exists. Ignored in worktree mode."
        },
        "relo.workspace.virtualReads": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Serve the model's file reads from the virtual workspace without a folder. Takes effect only when the runtime guarantees that every file tool goes through Relo; OpenCode runs its own file tools, so with it this is ignored (with a notice) and agents read their folders."
        },
        "relo.autoVerify": {
          "type": "boolean",
          "default": true,
          "description": "Run the project's own checks (tests, build) after an agent changes files, and send failures back to that agent to fix."
        },
        "relo.autoReview": {
          "type": "boolean",
          "default": true,
          "description": "Have a second agent review large or hard changes (a hard or expert task, 6 or more files, or 200 or more changed lines). Small changes are not reviewed, and a reviewer the Primary already planned is not duplicated."
        },
        "relo.runtime": {
          "type": "string",
          "enum": [
            "opencode",
            "mock"
          ],
          "default": "opencode",
          "description": "OpenCode backend, or mock for local testing without paid inference."
        },
        "relo.openCode.path": {
          "type": "string",
          "default": "",
          "description": "Path to the OpenCode binary."
        },
        "relo.claudeCode.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Run agents on the Claude Code CLI (claude) with its own sign-in. Its models are listed as claude-code/... and can be picked for any role. Relo starts one CLI process per agent with Relo's prompt and tools in place of Claude Code's, in safe mode (no CLAUDE.md, hooks, plugins or other MCP servers). The CLI keeps Claude's thinking between tool steps and caches the prompt. Usage counts against the signed-in account's plan limits, and what that account may be used for is set by its terms with Anthropic. Relo never reads the CLI's credentials."
        },
        "relo.claudeCode.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to the Claude Code CLI. Empty looks on PATH, then ~/.local/bin/claude, then the copy the Claude Code editor extension ships."
        },
        "relo.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info"
        },
        "relo.permissions.read": {
          "type": "string",
          "enum": [
            "allow",
            "ask",
            "deny"
          ],
          "default": "allow"
        },
        "relo.permissions.write": {
          "type": "string",
          "enum": [
            "allow",
            "ask",
            "deny"
          ],
          "default": "allow"
        },
        "relo.permissions.test": {
          "type": "string",
          "enum": [
            "allow",
            "ask",
            "deny"
          ],
          "default": "allow"
        },
        "relo.permissions.build": {
          "type": "string",
          "enum": [
            "allow",
            "ask",
            "deny"
          ],
          "default": "allow"
        },
        "relo.permissions.install": {
          "type": "string",
          "enum": [
            "allow",
            "ask",
            "deny"
          ],
          "default": "ask"
        },
        "relo.permissions.delete": {
          "type": "string",
          "enum": [
            "allow",
            "ask",
            "deny"
          ],
          "default": "ask"
        },
        "relo.permissions.gitCommit": {
          "type": "string",
          "enum": [
            "allow",
            "ask",
            "deny"
          ],
          "default": "ask"
        },
        "relo.permissions.gitPush": {
          "type": "string",
          "enum": [
            "allow",
            "ask",
            "deny"
          ],
          "default": "ask"
        },
        "relo.permissions.network": {
          "type": "string",
          "enum": [
            "allow",
            "ask",
            "deny"
          ],
          "default": "ask"
        },
        "relo.permissions.outside": {
          "type": "string",
          "enum": [
            "allow",
            "ask",
            "deny"
          ],
          "default": "ask"
        },
        "relo.permissions.destructive": {
          "type": "string",
          "enum": [
            "allow",
            "ask",
            "deny"
          ],
          "default": "ask"
        },
        "relo.permissions.yolo": {
          "type": "boolean",
          "default": false,
          "description": "YOLO mode: approve every permission request automatically, including installs, deletes, git commits and pushes, network access, paths outside the workspace and destructive commands, so agents can work without stopping. An action set to deny above stays denied. Only turn this on in a project and environment you are prepared to lose."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p . && node ../scripts/build-extension.mjs",
    "watch": "tsc -p . -w",
    "lint": "eslint src --max-warnings=0 && tsc -p . --noEmit",
    "typecheck": "tsc -p . --noEmit",

{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-relo",
      "type": "shell",
      "command": "make build",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$tsc", "$go"]
    },
    {
      "label": "test-relo",
      "type": "shell",
      "command": "make test",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test"
    }
  ]
}
